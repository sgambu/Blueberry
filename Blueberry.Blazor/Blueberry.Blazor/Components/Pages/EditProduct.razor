@page "/edit-product"
@layout SelectionLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject SelectedMerchantState MerchantState

<div class="page-container">
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <button class="btn-back" @onclick="GoBackToMerchantCategory" title="Retour à la gestion des stocks">
                    <span class="back-arrow">←</span> Retour au Merchant Category
                </button>
                <button class="btn-back" @onclick="GoBackToManager" title="Retour à la gestion des stocks">
                    <span class="back-arrow">←</span> Retour au Manager
                </button>
                <h2 class="page-title">Modifier les produits</h2>
                <p class="page-subtitle">Ajustez les prix et réapprovisionnez les stocks du magasin</p>
            </div>
        </div>
    </header>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <section class="form-section">
        <h4>Catégories et produits</h4>

        <div class="category-selection">
            <label for="category">Catégorie :</label>
                <select id="category" @bind="selectedCategoryId">
                    @if (merchantActiveCategories is not null)
                    {
                        @foreach (var category in merchantActiveCategories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }
                </select>
        </div>
    </section>
    <section class="form-section">
        <table class="product-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prix default</th>
                    <th>Taxe</th>
                    <th>Prix</th>
                    <th>Quantité</th>               
                    <th>Ajout Quantité</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var marProduct in selectedMerchant.MerchantProducts)
                {
                    Product product = allActiveProduct.FirstOrDefault(p => p.Id == marProduct.ProductId);
                    @if (product != null && product.CategoryId == selectedCategoryId)
                    {
                        Category cat = merchantActiveCategories.FirstOrDefault(c => c.Id == selectedCategoryId);
                        var taxeDescription = "";
                        @if (cat is not null)
                        {
                            @if (cat.Tps)
                            {
                                taxeDescription += "TPS ";
                            }

                            @if (cat.Tvq)
                            {
                                taxeDescription += "TVQ";
                            }

                            <tr @key="product.Id">
                                <td>@product.Name</td>
                                <td>@product.PriceDefault</td>
                                <td>@taxeDescription</td>
                                <td>
                                    <textarea value="@marProduct.Price"
                                              @onchange="e => UpdatePrice(product, e.Value?.ToString())">
                                    </textarea>
                                </td>  

                                <td>@marProduct.Stock</td>  
                                <td>
                                    <textarea value=""
                                              @onchange="e => UpdateQuantity(product, e.Value?.ToString())"
                                              placeholder="Entrez la quantité à ajouter">
                                    </textarea>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </section>
    <button @onclick="() => SaveChange()">Sauvegarder les changements</button>
    <MessageDialog @ref="messageDialog" />
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span class="alert-icon">⚠️</span>
            <div><strong>Attention :</strong> @errorMessage</div>
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => errorMessage = null"></button>
        </div>
    }
}
</div>

@code {
    private void GoBackToManager()
    {
        Navigation.NavigateTo("/manager");
    }

    private void GoBackToMerchantCategory()
    {
        Navigation.NavigateTo($"/marchant-category/{selectedMerchant.Id}");
    }

    private Merchant selectedMerchant = new();
    private List<Product> allActiveProduct = new();
    private ICollection<Category> merchantActiveCategories;
    private int selectedCategoryId = 0;
    private MessageDialog? messageDialog;
    private List<ProductModification> productModifications = new();
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            selectedMerchant = MerchantState.SelectedMerchant;
            
            List<Product> allProduct = await Http.GetFromJsonAsync<List<Product>>("api/Products") ?? new();
            allActiveProduct = allProduct.Where(p => p.IsActive).ToList();
            ICollection<Category> merchantCategories = selectedMerchant.Categories;
            merchantActiveCategories = merchantCategories.Where(c => c.IsActive).ToList();

            if (merchantActiveCategories is not null && merchantActiveCategories.Any())
            {
                selectedCategoryId = merchantCategories.First().Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Impossible de charger les données : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void UpdatePrice(Product product, string? newPriceString)
    {
        if (decimal.TryParse(newPriceString, out decimal newPrice))
        {
            var existingModification = productModifications.FirstOrDefault(pm => pm.ProductId == product.Id);
            if (existingModification != null)
            {
                existingModification.NewPrice = newPrice;
            }
            else
            {
                productModifications.Add(new ProductModification
                {
                    ProductId = product.Id,
                    NewPrice = newPrice
                });
            }
        }
    }

    private void UpdateQuantity(Product product, string? newQuantityString)
    {
        if (int.TryParse(newQuantityString, out int newQuantity))
        {
            var existingModification = productModifications.FirstOrDefault(pm => pm.ProductId == product.Id);
            if (existingModification != null)
            {
                existingModification.QuantityToAdd = newQuantity;
            }
            else
            {
                productModifications.Add(new ProductModification
                {
                    ProductId = product.Id,
                    QuantityToAdd = newQuantity
                });
            }
        }    
    }

    private async Task SaveChange()
    {
        try
        {
            foreach (var modification in productModifications)
            {
                HttpResponseMessage response = await Http.PutAsJsonAsync($"api/MerchantProducts/{selectedMerchant.Id}", modification);
                if (!response.IsSuccessStatusCode)
                {
                    throw new Exception($"Erreur lors de la mise à jour du produit avec l'ID {modification.ProductId}. Statut : {response.StatusCode}");
                }
            }
            selectedMerchant = await Http.GetFromJsonAsync<Merchant>($"api/Merchants/{selectedMerchant.Id}") ?? new();
            MerchantState.SelectedMerchant = selectedMerchant;
            productModifications.Clear();
            if (messageDialog is not null)
            {
                messageDialog.Title = "Sauvegarde réussie";
                messageDialog.Message = "Les produits ont été sauvegardés avec succès!";

                await messageDialog.ShowAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
        }
    }
}


