@page "/categories"
@layout SelectionLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="categories-page">
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <button class="btn-back" @onclick="GoToHome" title="Retour à la liste des magasins">
                    <span class="back-arrow">←</span> Retour aux magasins
                </button>
                <h2 class="page-title">Gestion des Catégories</h2>
                <p class="page-subtitle">Ajoutez de nouvelles catégories et modifiez les paramètres de taxes (TPS / TVQ).</p>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <span class="alert-icon">✓</span>
            <div><strong>Succès !</strong> @successMessage</div>
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span class="alert-icon">⚠️</span>
            <div><strong>Attention :</strong> @errorMessage</div>
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- ==========================================
         Section Catégories (Haut)
         ========================================== -->
    <div class="content-grid mb-5">
        <!-- Liste des catégories existantes -->
        <section class="card-panel list-panel">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3>Catégories existantes</h3>
                    <span class="badge count-badge">@(categories?.Count ?? 0)</span>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p>Chargement des catégories...</p>
                </div>
            }
            else if (categories == null || categories.Count == 0)
            {
                <div class="empty-state">
                    <p>Aucune catégorie enregistrée pour le moment.</p>
                    <button class="btn btn-primary" @onclick="StartNewCategory">Créer une première catégorie</button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table categories-table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>TPS (5%)</th>
                                <th>TVQ (9.975%)</th>
                                <th>Statut</th>
                                <th>Produits</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in categories)
                            {
                                var isSelected = (editingCategory?.Id == cat.Id);
                                var isCategoryActive = (selectedCategoryId == cat.Id);
                                var productCount = GetProductCountForCategory(cat.Id);

                                <tr class="@(isSelected ? "selected-row" : (isCategoryActive ? "table-light" : ""))">
                                    <td class="col-name">
                                        <strong>@cat.Name</strong>
                                    </td>
                                    <td>
                                        @if (cat.Tps)
                                        {
                                            <span class="badge badge-tps">TPS active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-none">Exonérée</span>
                                        }
                                    </td>
                                    <td>
                                        @if (cat.Tvq)
                                        {
                                            <span class="badge badge-tvq">TVQ active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-none">Exonérée</span>
                                        }
                                    </td>
                                    <td>
                                        @if (cat.IsActive)
                                        {
                                            <span class="badge badge-success">Actif</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactif</span>
                                        }
                                    </td>
                                    <td class="text-end col-actions">
                                        <button type="button"
                                                class="btn btn-sm @(isCategoryActive ? "btn-primary" : "btn-outline-primary")"
                                                title="Afficher les produits de cette catégorie"
                                                @onclick="() => GetProductForCategory(cat.Id)">
                                            📦 @productCount produit(s)
                                        </button>
                                    </td>
                                    <td class="text-end col-actions">
                                        <button class="btn btn-sm btn-action btn-edit"
                                                title="Modifier cette catégorie"
                                                @onclick="() => EditCategory(cat)">
                                            ✏️ Modifier
                                        </button>
                                        <button class="btn btn-sm btn-action btn-delete"
                                                title="Supprimer cette catégorie"
                                                @onclick="() => DeleteCategory(cat)">
                                            🗑️
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Formulaire d'ajout / modification de catégorie -->
        <section class="card-panel form-panel">
            <div class="panel-header">
                @if (editingCategory != null)
                {
                    <h3>Modifier la catégorie</h3>
                }
                else
                {
                    <h3>Ajouter une catégorie</h3>
                }
            </div>

            <div class="form-body">
                @if (editingCategory != null)
                {
                    <div class="edit-badge-bar">
                        <span class="badge bg-warning text-dark">Mode Édition : Catégorie #@editingCategory.Id</span>
                    </div>
                }

                <div class="mb-3">
                    <label for="categoryName" class="form-label">Nom de la catégorie <span class="text-danger">*</span></label>
                    <input type="text"
                           id="categoryName"
                           class="form-control @(categoryNameValidationError != null ? "is-invalid" : "")"
                           placeholder="ex: Fruits frais, Pâtisseries, Boissons..."
                           maxlength="50"
                           @bind="currentCategoryName"
                           @bind:event="oninput" />
                    @if (categoryNameValidationError != null)
                    {
                        <div class="invalid-feedback">@categoryNameValidationError</div>
                    }
                    <small class="form-text-muted">Maximum 50 caractères</small>
                </div>

                <div class="taxes-box mb-4">
                    <label class="form-label fw-bold mb-2">Application des taxes :</label>
                    
                    <div class="tax-option">
                        <label class="tax-label">
                            <input class="tax-checkbox"
                                   type="checkbox"
                                   id="tpsSwitch"
                                   @bind="currentCategoryTps" />
                            <div>
                                <div class="tax-name">TPS (5%)</div>
                                <div class="tax-desc">Taxe sur les produits et services (fédérale)</div>
                            </div>
                        </label>
                    </div>

                    <div class="tax-option">
                        <label class="tax-label">
                            <input class="tax-checkbox"
                                   type="checkbox"
                                   id="tvqSwitch"
                                   @bind="currentCategoryTvq" />
                            <div>
                                <div class="tax-name">TVQ (9.975%)</div>
                                <div class="tax-desc">Taxe de vente du Québec (provinciale)</div>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="form-actions">
                    @if (editingCategory != null)
                    {
                        <button class="btn btn-primary"
                                disabled="@isSubmitting"
                                @onclick="SaveCategory">
                            @(isSubmitting ? "Enregistrement..." : "💾 Enregistrer les modifications")
                        </button>
                        <button class="btn btn-outline-secondary"
                                disabled="@isSubmitting"
                                @onclick="CancelEdit">
                            Annuler
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary"
                                disabled="@isSubmitting"
                                @onclick="SaveCategory">
                            @(isSubmitting ? "Ajout en cours..." : "➕ Ajouter la catégorie")
                        </button>
                        <button class="btn btn-outline-secondary"
                                disabled="@isSubmitting"
                                @onclick="ResetForm">
                            Réinitialiser
                        </button>
                    }
                </div>
            </div>
        </section>
    </div>

    <!-- Séparateur visuel de section -->
    <div class="section-divider">
        <div>
            <h3 class="section-title">Produits</h3>
            <p class="section-subtitle">
                @if (selectedCategory != null)
                {
                    <span>Produits de la catégorie <strong>« @selectedCategory.Name »</strong></span>
                }
                else
                {
                    <span>Sélectionnez une catégorie ci-dessus pour afficher et gérer ses produits.</span>
                }
            </p>
        </div>
    </div>

    <!-- ==========================================
         Section Produits (Bas)
         ========================================== -->
    <div class="content-grid">
        <!-- Liste des produits dans la catégorie -->
        <section class="card-panel list-panel">
            <div class="panel-header">
                <div class="panel-title-group">
                    @if (selectedCategory != null)
                    {
                        <h3>Produits : @selectedCategory.Name</h3>
                    }
                    else
                    {
                        <h3>Produits</h3>
                    }
                    <span class="badge count-badge">@(productInCat?.Count ?? 0)</span>
                </div>
                @if (editingProduct != null)
                {
                    <button class="btn btn-sm btn-outline-primary"
                            title="Basculer vers l'ajout d'un nouveau produit"
                            @onclick="StartNewProduct">
                        ➕ Nouveau produit
                    </button>
                }
            </div>

            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement...</span>
                    </div>
                    <p>Chargement des produits...</p>
                </div>
            }
            else if (selectedCategoryId == null)
            {
                <div class="empty-state">
                    <p>Sélectionnez une catégorie ci-dessus en cliquant sur « 📦 X produit(s) » pour afficher ses produits.</p>
                </div>
            }
            else if (productInCat == null || productInCat.Count == 0)
            {
                <div class="empty-state">
                    <p>Aucun produit enregistré dans cette catégorie pour le moment.</p>
                    <button class="btn btn-primary" @onclick="StartNewProduct">Créer un premier produit</button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table categories-table">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Prix par défaut</th>
                                <th>Actif</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in productInCat)
                            {
                                var isProductSelected = (editingProduct?.Id == product.Id);
                                <tr class="@(isProductSelected ? "selected-row" : "")">  
                                    <td class="col-name">
                                        <strong>@product.Name</strong>
                                    </td>
                                    <td class="col-price">
                                        @product.PriceDefault.ToString("C")
                                    </td>
                                    <td>
                                        @if (product.IsActive)
                                        {
                                            <span class="badge badge-success">Actif</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactif</span>
                                        }
                                    </td>
                                    <td class="text-end col-actions">
                                        <button class="btn btn-sm btn-action btn-edit"
                                                title="Modifier ce produit"
                                                @onclick="() => EditProduct(product)">
                                            ✏️ Modifier
                                        </button>
                                        <button class="btn btn-sm btn-action btn-delete"
                                                title="Supprimer ce produit"
                                                @onclick="() => DeleteProduct(product)">
                                            🗑️
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Formulaire d'ajout / modification du produit -->
        <section class="card-panel form-panel">
            <div class="panel-header">
                @if (editingProduct != null)
                {
                    <h3>Modifier le produit</h3>
                }
                else
                {
                    <h3>Ajouter un produit</h3>
                }
            </div>

            <div class="form-body">
                @if (editingProduct != null)
                {
                    <div class="edit-badge-bar">
                        <span class="badge bg-warning text-dark">Mode Édition : Produit #@editingProduct.Id</span>
                    </div>
                }

                <div class="mb-3">
                    <label for="productName" class="form-label">Nom du produit <span class="text-danger">*</span></label>
                    <input type="text"
                           id="productName"
                           class="form-control @(productNameValidationError != null ? "is-invalid" : "")"
                           placeholder="ex: Pommes Gala, Croissant au beurre, Café latté..."
                           maxlength="50"
                           @bind="currentProductName"
                           @bind:event="oninput" />
                    @if (productNameValidationError != null)
                    {
                        <div class="invalid-feedback">@productNameValidationError</div>
                    }
                    <small class="form-text-muted">Maximum 50 caractères</small>
                </div>

                <div class="mb-3">
                    <label for="productPrice" class="form-label">Prix par défaut <span class="text-danger">*</span></label>
                    <input type="number"
                           id="productPrice"
                           class="form-control"
                           placeholder="ex: 10.99"
                           step="0.01"
                           min="0"
                           @bind="currentProductPriceDefault" />
                </div>

                <div class="mb-3">
                    <label for="productCategory" class="form-label">Catégorie <span class="text-danger">*</span></label>
                    <select id="productCategory"
                            class="form-select"
                            @bind="currentProductCategoryId">
                        @if (categories == null || categories.Count == 0)
                        {
                            <option value="0" disabled>Aucune catégorie disponible</option>
                        }
                        else
                        {
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                    <small class="form-text-muted">
                        Catégorie sélectionnée : <strong>@(categories?.FirstOrDefault(c => c.Id == currentProductCategoryId)?.Name ?? "Non assignée")</strong>
                    </small>
                </div>
                <div class="mb-3">
                    @if (editingProduct != null)
                    {
                        <label for="productActive" class="form-label">Statut du produit</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="productActive"
                                   @bind="editingProduct.IsActive" />
                            <label class="form-check-label" for="productActive">
                                @(editingProduct.IsActive ? "Actif" : "Inactif")
                            </label>
                        </div>
                    }
                </div>
                <div class="form-actions">
                    @if (editingProduct != null)
                    {
                        <button class="btn btn-primary"
                                disabled="@isSubmitting"
                                @onclick="SaveProduct">
                            @(isSubmitting ? "Enregistrement..." : "💾 Enregistrer les modifications")
                        </button>
                        <button class="btn btn-outline-secondary"
                                disabled="@isSubmitting"
                                @onclick="CancelProductEdit">
                            Annuler
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary"
                                disabled="@isSubmitting"
                                @onclick="SaveProduct">
                            @(isSubmitting ? "Ajout en cours..." : "➕ Ajouter le produit")
                        </button>
                        <button class="btn btn-outline-secondary"
                                disabled="@isSubmitting"
                                @onclick="ResetProductForm">
                            Réinitialiser
                        </button>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private List<Category> categories = new();
    private List<Product> allProducts = new();
    List<Product> productInCat = new();
    private bool isLoading = true;
    private bool isSubmitting = false;

    private bool isEditing = false;
    private Category? editingCategory = null;
    private Product? editingProduct = null;
    private int? selectedCategoryId = null;

    private Category? selectedCategory => categories.FirstOrDefault(c => c.Id == selectedCategoryId);

    // Champs pour Catégorie
    private string currentCategoryName = "";
    private bool currentCategoryTps = false;
    private bool currentCategoryTvq = false;
    private string? categoryNameValidationError;

    // Champs pour Produit
    private string currentProductName = "";
    private decimal currentProductPriceDefault = 0m;
    private int currentProductCategoryId = 0;
    private string? productNameValidationError;

    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            categories = await Http.GetFromJsonAsync<List<Category>>("api/Categories") ?? new();
            allProducts = await Http.GetFromJsonAsync<List<Product>>("api/Products") ?? new();

            if (selectedCategoryId.HasValue && categories.Any(c => c.Id == selectedCategoryId.Value))
            {
                GetProductForCategory(selectedCategoryId.Value);
            }
            else if (categories.Count > 0)
            {
                GetProductForCategory(categories[0].Id);
            }

            if (currentProductCategoryId <= 0 && categories.Count > 0)
            {
                currentProductCategoryId = selectedCategoryId ?? categories[0].Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Impossible de charger les données : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GetProductForCategory(int categoryId)
    {
        selectedCategoryId = categoryId;
        productInCat = allProducts.Where(p => p.CategoryId == categoryId).ToList();

        // Si on n'est pas en train d'éditer un produit existant, aligner la catégorie par défaut du formulaire d'ajout
        if (editingProduct == null)
        {
            currentProductCategoryId = categoryId;
        }
    }

    private int GetProductCountForCategory(int categoryId)
    {
        return allProducts?.Count(p => p.CategoryId == categoryId) ?? 0;
    }

    // Gestion Catégories
    private void StartNewCategory()
    {
        isEditing = false;
        editingCategory = null;
        currentCategoryName = "";
        currentCategoryTps = false;
        currentCategoryTvq = false;
        categoryNameValidationError = null;
        errorMessage = null;
    }

    private void EditCategory(Category cat)
    {
        isEditing = true;
        editingCategory = cat;
        currentCategoryName = cat.Name;
        currentCategoryTps = cat.Tps;
        currentCategoryTvq = cat.Tvq;
        categoryNameValidationError = null;
        errorMessage = null;
        successMessage = null;
    }

    private void CancelEdit()
    {
        StartNewCategory();
    }

    private void ResetForm()
    {
        StartNewCategory();
    }

    private async Task SaveCategory()
    {
        categoryNameValidationError = null;
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(currentCategoryName))
        {
            categoryNameValidationError = "Veuillez entrer un nom pour la catégorie.";
            return;
        }

        if (currentCategoryName.Trim().Length > 50)
        {
            categoryNameValidationError = "Le nom ne doit pas dépasser 50 caractères.";
            return;
        }

        isSubmitting = true;

        try
        {
            if (editingCategory != null)
            {
                var updated = new Category
                {
                    Id = editingCategory.Id,
                    Name = currentCategoryName.Trim(),
                    Tps = currentCategoryTps,
                    Tvq = currentCategoryTvq,
                    IsActive = editingCategory.IsActive
                };

                var response = await Http.PutAsJsonAsync($"api/Categories/{editingCategory.Id}", updated);

                if (response.IsSuccessStatusCode)
                {
                    successMessage = $"La catégorie « {updated.Name} » a été modifiée avec succès !";
                    await LoadDataAsync();
                    StartNewCategory();
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Erreur lors de la modification : {msg}";
                }
            }
            else
            {
                var newCat = new Category
                {
                    Name = currentCategoryName.Trim(),
                    Tps = currentCategoryTps,
                    Tvq = currentCategoryTvq,
                    IsActive = true
                };

                var response = await Http.PostAsJsonAsync("api/Categories", newCat);

                if (response.IsSuccessStatusCode)
                {
                    successMessage = $"La catégorie « {newCat.Name} » a été créée avec succès !";
                    await LoadDataAsync();
                    StartNewCategory();
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Erreur lors de la création : {msg}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteCategory(Category cat)
    {
        errorMessage = null;
        successMessage = null;

        /*var count = GetProductCountForCategory(cat.Id);
        if (count > 0)
        {
            errorMessage = $"Impossible de supprimer la catégorie « {cat.Name} » car elle contient {count} produit(s). Réassignez d'abord ces produits avant de la supprimer.";
            return;
        }*/

        try
        {
            var response = await Http.DeleteAsync($"api/Categories/{cat.Id}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<EntityModels.SqlServer.DTOs.DeleteProductResponse>();
                successMessage = result?.Message;

                //successMessage = $"La catégorie « {cat.Name} » a été supprimée avec succès.";
                if (editingCategory?.Id == cat.Id)
                {
                    StartNewCategory();
                }
                await LoadDataAsync();
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                errorMessage = $"Erreur lors de la suppression : {msg}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de la suppression : {ex.Message}";
        }
    }

    // Gestion Produits
    private void StartNewProduct()
    {
        editingProduct = null;
        currentProductName = "";
        currentProductPriceDefault = 0m;
        currentProductCategoryId = selectedCategoryId ?? (categories.FirstOrDefault()?.Id ?? 0);
        productNameValidationError = null;
        errorMessage = null;
    }

    private void EditProduct(Product product)
    {
        editingProduct = product;
        currentProductName = product.Name;
        currentProductPriceDefault = product.PriceDefault;
        currentProductCategoryId = product.CategoryId;
        productNameValidationError = null;
        errorMessage = null;
        successMessage = null;
    }

    private void CancelProductEdit()
    {
        StartNewProduct();
    }

    private void ResetProductForm()
    {
        StartNewProduct();
    }

    private async Task SaveProduct()
    {
        productNameValidationError = null;
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(currentProductName))
        {
            productNameValidationError = "Veuillez entrer un nom pour le produit.";
            return;
        }

        if (currentProductName.Trim().Length > 50)
        {
            productNameValidationError = "Le nom ne doit pas dépasser 50 caractères.";
            return;
        }

        if (currentProductCategoryId <= 0)
        {
            errorMessage = "Veuillez sélectionner une catégorie pour le produit.";
            return;
        }

        isSubmitting = true;

        try
        {
            if (editingProduct != null)
            {
                var updated = new Product
                {
                    Id = editingProduct.Id,
                    Name = currentProductName.Trim(),
                    PriceDefault = currentProductPriceDefault,
                    CategoryId = currentProductCategoryId,
                    IsActive = editingProduct.IsActive
                };

                var response = await Http.PutAsJsonAsync("api/Products", updated);

                if (response.IsSuccessStatusCode)
                {
                    successMessage = $"Le produit « {updated.Name} » a été modifié avec succès !";
                    await LoadDataAsync();
                    if (selectedCategoryId.HasValue)
                    {
                        GetProductForCategory(selectedCategoryId.Value);
                    }
                    StartNewProduct();
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Erreur lors de la modification : {msg}";
                }
            }
            else
            {
                var newProduct = new Product
                {
                    Name = currentProductName.Trim(),
                    PriceDefault = currentProductPriceDefault,
                    CategoryId = currentProductCategoryId,
                    IsActive = true
                };

                var response = await Http.PostAsJsonAsync("api/Products", newProduct);

                if (response.IsSuccessStatusCode)
                {
                    successMessage = $"Le produit « {newProduct.Name} » a été ajouté avec succès !";
                    selectedCategoryId = newProduct.CategoryId;
                    await LoadDataAsync();
                    GetProductForCategory(newProduct.CategoryId);
                    StartNewProduct();
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Erreur lors de la création : {msg}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteProduct(Product product)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"api/Products/{product.Id}");

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content
                    .ReadFromJsonAsync<EntityModels.SqlServer.DTOs.DeleteProductResponse>();

                successMessage = result?.Message;

                if (editingProduct?.Id == product.Id)
                {
                    StartNewProduct();
                }

                await LoadDataAsync();

                if (selectedCategoryId.HasValue)
                {
                    GetProductForCategory(selectedCategoryId.Value);
                }
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                errorMessage = $"Erreur lors de la suppression : {msg}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de la suppression : {ex.Message}";
        }
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }
