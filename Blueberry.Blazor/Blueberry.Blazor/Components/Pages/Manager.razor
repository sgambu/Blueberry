@page "/manager"
@inject HttpClient Http
@inject SelectedMerchantState MerchantState
@inject NavigationManager Navigation

<h3>Manager</h3>
<div class="pos-container">
    <section class="products-panel">
        @{bool fistTime = true;}
        @foreach (var category in categories)
        {
            @if (merchantProducts.Any(mp => allProducts.Any(p => p.Id == mp.ProductId && p.CategoryId == category.Id) && mp.Stock <= 0))
            {
                <p>@category.Name</p>
                @foreach (var merProduct in merchantProducts)
                {
                    Product product = allProducts.FirstOrDefault(p => p.Id == merProduct.ProductId);

                    @if (product != null && product.CategoryId == category.Id)
                    {
                        @if (merProduct.Stock <= 0)
                        {
                            @if (fistTime)
                            {
                                <h3>Attention il ne reste plus de ces produits en stock!</h3>
                                fistTime = false;
                            }
                            <div style="color:red; margin-left:20px;">
                                <p>@product.Name   Prix: @merProduct.Price.ToString("C")</p>
                            </div>
                        }
                    }
                }
            }
        }       
        @{fistTime = true;}
        
        @foreach (var category in categories)
        {
            @if (merchantProducts.Any(mp => allProducts.Any(p => p.Id == mp.ProductId && p.CategoryId == category.Id) && mp.Stock > 0 && mp.Stock < 6))
            {
                <p>@category.Name</p>
                @foreach (var merProduct in merchantProducts)
                {
                    Product product = allProducts.FirstOrDefault(p => p.Id == merProduct.ProductId);

                    @if (product != null && product.CategoryId == category.Id)
                    {
                        @if (merProduct.Stock > 0 && merProduct.Stock < 6)
                        {
                            @if (fistTime)
                            {
                                <h3>Attention il ne reste que peu de produits en stock!</h3>
                                fistTime = false;
                            }
                            <div style="color:cadetblue; margin-left:20px;">
                                <p>@product.Name   Prix: @merProduct.Price.ToString("C")   Quantité en stock: @merProduct.Stock</p>
                            </div>
                        }
                    }
                }
            }
        }
        <button @onclick="EditProduct">
            Modifier les produits
        </button>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <span class="alert-icon">⚠️</span>
                <div><strong>Attention :</strong> @errorMessage</div>
                <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => errorMessage = null"></button>
            </div>
        }
    </section>
</div>



@code {
    private IEnumerable<Product>? allProducts;
    private int quantityToAdd = 0;
    private List<MerchantProduct> merchantProducts = new();
    private List<Category> categories = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allProducts = await Http.GetFromJsonAsync<List<Product>>("api/Products");
            merchantProducts = MerchantState.SelectedMerchant.MerchantProducts.ToList();
            categories = await Http.GetFromJsonAsync<List<Category>>("api/Categories") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Impossible de charger les données : {ex.Message}";
        }
    }

    private void EditProduct()
    {
        Navigation.NavigateTo("/edit-product");
    }
}
