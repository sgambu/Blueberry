@page "/accounting"
@attribute [StreamRendering]
@layout SelectionLayout
@inject HttpClient Http
@inject SelectedMerchantState MerchantState
@inject NavigationManager Navigation

<div class="categories-page accounting-page">
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <button class="btn-back" @onclick="GoToStore" title="Retour au tableau de bord du magasin">
                    <span class="back-arrow">←</span> Retour au Magasin
                </button>
                <h2 class="page-title">Comptabilité & Rapports</h2>
                <p class="page-subtitle">Consultez l'historique et les statistiques de ventes de votre magasin.</p>
            </div>
        </div>
    </header>

    <!-- Barre d'onglets / filtres -->
    <section class="card-panel mb-4">
        <div class="panel-header">
            <div class="panel-title-group">
                <h3>Sélectionner un rapport</h3>
            </div>
        </div>
        <div class="form-body d-flex gap-3 flex-wrap">
            <button class="btn @(showSalesByDay ? "btn-primary" : "btn-outline-primary")" @onclick="GetTotalSalesByDay">
                📅 Total des ventes par jour
            </button>
            <button class="btn @(showSalesByProduct ? "btn-primary" : "btn-outline-primary")" @onclick="TotalByProduct">
                📦 Quantité vendue par produit
            </button>
        </div>
    </section>

    <!-- Rapport : Ventes par jour -->
    @if (showSalesByDay)
    {
        <section class="card-panel list-panel mb-4">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3>Total des Ventes par Jour</h3>
                    <span class="badge count-badge">@salesByDay.Count jour(s)</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table categories-table align-middle">
                    <thead>
                        <tr>
                            <th>Date de vente</th>
                            <th>Total des Ventes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (salesByDay.Count == 0)
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted p-4">Aucune vente enregistrée pour ce magasin.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var sale in salesByDay)
                            {
                                <tr>
                                    <td class="col-name"><strong>@sale.DateSales</strong></td>
                                    <td class="col-price">@sale.Total.ToString("C")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <!-- Rapport : Ventes par produit -->
    @if (showSalesByProduct)
    {
        <section class="card-panel list-panel mb-4">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3>Quantité Vendue par Produit</h3>
                    <span class="badge count-badge">@salesByProduct.Count produit(s)</span>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table categories-table align-middle">
                    <thead>
                        <tr>
                            <th>Nom du Produit</th>
                            <th>Quantité Vendue</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (salesByProduct.Count == 0)
                        {
                            <tr>
                                <td colspan="2" class="text-center text-muted p-4">Aucun article vendu pour le moment.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var sale in salesByProduct)
                            {
                                <tr>
                                    <td class="col-name"><strong>@(sale.Name ?? "Produit inconnu")</strong></td>
                                    <td>
                                        <span class="badge badge-active fs-6">@sale.Quantity unité(s)</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private List<Sale> sales = new();
    private List<SalesByDay> salesByDay = new();
    private List<ProductByQuantity> salesByProduct = new();
    private List<Product> allProduct = new();
    private int merchantId;
    private bool showSalesByDay = true;
    private bool showSalesByProduct = false;
    private bool showSalesByDaySummary = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            merchantId = MerchantState.SelectedMerchant.Id;
            sales = await Http.GetFromJsonAsync<List<Sale>>($"api/Sales/{merchantId}") ?? new();
            allProduct = await Http.GetFromJsonAsync<List<Product>>("api/Products") ?? new();
            GetTotalSalesByDay();
        }
        catch
        {
            sales = new();
            allProduct = new();
        }
    }

    private void GetTotalSalesByDay()
    {
        showSalesByDay = true;
        showSalesByProduct = false;
        showSalesByDaySummary = false;

        salesByDay = sales
            .GroupBy(s => s.Date.ToString("dd/MM/yyyy"))
            .Select(g => new SalesByDay
            {
                DateSales = g.Key,
                Total = g.Sum(s => s.Total)
            })
            .ToList();
    }

    public class SalesByDay
    {
        public string DateSales { get; set; } = "";
        public decimal Total { get; set; }
    }

    private void TotalByProduct()
    {
        showSalesByDay = false;
        showSalesByProduct = true;
        showSalesByDaySummary = false;

        salesByProduct = sales
            .SelectMany(s => s.SaleItems)
            .GroupBy(si => si.ProductId)
            .Select(g => new ProductByQuantity
            {
                Name = allProduct.FirstOrDefault(p => p.Id == g.Key)?.Name,
                Quantity = g.Sum(si => si.Quantity)
            })
            .ToList();
    }

    public class ProductByQuantity
    {
        public string? Name { get; set; }
        public int Quantity { get; set; }
    }

    private void GoToStore()
    {
        Navigation.NavigateTo("/store");
    }
}
