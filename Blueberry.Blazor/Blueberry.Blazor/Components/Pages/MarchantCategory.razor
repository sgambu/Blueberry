@page "/marchant-category/{id?}"
@layout SelectionLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject SelectedMerchantState MerchantState
@inject IJSRuntime JS

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" ConfirmExternalNavigation="@hasUnsavedProductChanges" />

<div class="categories-page marchant-category-page">
    <header class="page-header">
        <div class="header-content">
            <div class="header-left">
                <button class="btn-back" @onclick="GoToHome" title="Retour à la liste des magasins">
                    <span class="back-arrow">←</span> Retour aux magasins
                </button>
                <h2 class="page-title">Configuration du Marchand</h2>
                <p class="page-subtitle">Modifiez les coordonnées du magasin et assignez les produits disponibles par catégorie.</p>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <span class="alert-icon">✓</span>
            <div><strong>Succès !</strong> @successMessage</div>
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <span class="alert-icon">⚠️</span>
            <div><strong>Attention :</strong> @errorMessage</div>
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (hasUnsavedProductChanges)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <span class="alert-icon">⚠️</span>
            <div>
                <strong>Modifications non enregistrées :</strong> Vous avez modifié la liste des produits assignés à ce marchand. Pensez à cliquer sur <strong>« Sauvegarder les produits »</strong> !
            </div>
        </div>
    }

    <!-- ==========================================
         Section 1 : Informations du marchand
         ========================================== -->
    <section class="card-panel mb-4">
        <div class="panel-header">
            <div class="panel-title-group">
                <h3>Coordonnées du Marchand</h3>
                @if (merchantId != 0)
                {
                    <span class="badge count-badge">Magasin #@merchantId</span>
                    @if (selectedMerchant.IsActive)
                    {
                        <span class="badge badge-active ms-2">Actif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white ms-2">Inactif</span>
                    }
                }
            </div>
        </div>

        <div class="form-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="merchantAddress" class="form-label fw-bold">Adresse <span class="text-danger">*</span></label>
                    <input type="text"
                           id="merchantAddress"
                           class="form-control"
                           placeholder="ex: 123 rue Principale, Montréal"
                           @bind="selectedMerchant.Adresse" />
                </div>

                <div class="col-md-6">
                    <label for="merchantPhone" class="form-label fw-bold">Téléphone <span class="text-danger">*</span></label>
                    <input type="text"
                           id="merchantPhone"
                           class="form-control"
                           placeholder="ex: (514) 555-0199"
                           @bind="selectedMerchant.Phone" />
                </div>

                @if (merchantId != 0)
                {
                    <div class="col-12">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="merchantActiveSwitch"
                                   @bind="selectedMerchant.IsActive" />
                            <label class="form-check-label fw-bold" for="merchantActiveSwitch">
                                @(selectedMerchant.IsActive ? "Marchand actif" : "Marchand inactif")
                            </label>
                        </div>
                    </div>
                }
            </div>

            <div class="form-actions mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" @onclick="SaveMerchantChanges">
                        💾 Sauvegarder les informations
                    </button>
                    @if (id is not null)
                    {
                        <button class="btn btn-outline-secondary" @onclick="ShowProductInfo">
                            ℹ️ Informations sur les produits
                        </button>
                    }
                </div>
                @if (id is not null && merchantId != 0)
                {
                    <button class="btn btn-outline-danger" @onclick="DeleteMerchant" title="Supprimer ou désactiver ce marchand">
                        🗑️ Supprimer ce marchand
                    </button>
                }
            </div>
        </div>
    </section>

    <!-- ==========================================
         Section 2 : Catégories et produits
         ========================================== -->
    @if (merchantId != 0 && !isLoading)
    {
        <section class="card-panel mb-4">
            <div class="panel-header">
                <div class="panel-title-group">
                    <h3>Catégories et Produits Disponibles</h3>
                    <span class="badge count-badge">@(merchantProducts.Count(mp => mp.MerchantId == selectedMerchant.Id)) produit(s) assigné(s)</span>
                </div>
            </div>

            <div class="form-body">
                <div class="mb-4">
                    <label for="category" class="form-label fw-bold">Sélectionner une catégorie :</label>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <select id="category" class="form-select" style="max-width: 380px;" @bind="selectedCategoryId">
                            @foreach (var category in allActiveCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>

                        @{
                            Blueberry.EntityModels.Category cat = GetCategoryInfo();
                        }
                        <div class="d-flex gap-2 align-items-center">
                            @if (cat.Tps)
                            {
                                <span class="badge badge-tps">TPS active (5%)</span>
                            }
                            else
                            {
                                <span class="badge badge-none">TPS exonérée</span>
                            }

                            @if (cat.Tvq)
                            {
                                <span class="badge badge-tvq">TVQ active (9.975%)</span>
                            }
                            else
                            {
                                <span class="badge badge-none">TVQ exonérée</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="products-box mb-4">
                    <h5 class="fw-bold mb-3 text-secondary">Cochez les produits vendus par ce marchand :</h5>

                    @{
                        var productsInCat = allActiveProduct.Where(p => p.CategoryId == selectedCategoryId).ToList();
                    }

                    @if (productsInCat.Count == 0)
                    {
                        <div class="empty-state p-4 text-center text-muted">
                            <p class="mb-0">Aucun produit actif n'est disponible dans cette catégorie.</p>
                        </div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var product in productsInCat)
                            {
                                var isInMerchant = IsProductInMerchant(product.Id);
                                <div class="col-md-6 col-lg-4">
                                    <div class="product-check-card @(isInMerchant ? "checked" : "")">
                                        <label class="d-flex align-items-center justify-content-between gap-3 p-3 w-100 mb-0" style="cursor: pointer;">
                                            <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                                                <input @key="@($"{selectedCategoryId}-{product.Id}")"
                                                       type="checkbox"
                                                       class="form-check-input mt-0 flex-shrink-0"
                                                       style="width: 1.3rem; height: 1.3rem;"
                                                       checked="@isInMerchant"
                                                       @onchange="(e) => ProductSelectionChanged(product.Id, e)" />
                                                <div class="text-truncate" style="min-width: 0;">
                                                    <div class="fw-bold text-dark text-truncate" title="@product.Name">@product.Name</div>
                                                    <small class="text-muted d-block" style="white-space: nowrap;">Prix défaut : @product.PriceDefault.ToString("C")</small>
                                                </div>
                                            </div>
                                            @if (isInMerchant)
                                            {
                                                <span class="badge badge-active flex-shrink-0">Assigné</span>
                                            }
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Action Save Products Button with attention color when modified -->
                <div class="form-actions d-flex gap-3 align-items-center flex-wrap pt-3 border-top">
                    <button class="@(hasUnsavedProductChanges ? "btn btn-save-modified" : "btn btn-primary")"
                            @onclick="SaveProductChanges">
                        @(hasUnsavedProductChanges ? "⚠️ 💾 Sauvegarder les produits (Modifications en attente !)" : "💾 Sauvegarder les produits")
                    </button>

                    <button class="btn btn-outline-secondary" @onclick="EditProduct">
                        ✏️ Modifier les produits (prix et stocks)
                    </button>

                    @if (hasUnsavedProductChanges)
                    {
                        <span class="text-warning fw-bold ms-2">
                            ⚠️ Pensez à enregistrer vos changements !
                        </span>
                    }
                </div>
            </div>
        </section>
    }

    <ProductInfoDialog @ref="productInfoDialog"
                       SelectedMerchant="@selectedMerchant"
                       Products="@allActiveProduct" />

    <MessageDialog @ref="messageDialog" />
</div>

@code {
    [Parameter]
    public string? id { get; set; }

    private int merchantId;

    private Merchant selectedMerchant = new();
    private List<MerchantProduct> oriMerchantProducts = new();
    private List<MerchantProduct> merchantProducts = new();
    private List<Category> allActiveCategories = new();
    private List<MerchantProduct> allMerchantProducts = new();
    private List<Product> allActiveProduct = new();
    private MessageDialog? messageDialog;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading = true;

    private int selectedCategoryId = 1;
    private ProductInfoDialog? productInfoDialog;

    private bool HasUnsavedProductChanges()
    {
        var currentIds = merchantProducts.Where(mp => mp.MerchantId == selectedMerchant.Id).Select(mp => mp.ProductId).ToHashSet();
        var originalIds = oriMerchantProducts.Where(mp => mp.MerchantId == selectedMerchant.Id).Select(mp => mp.ProductId).ToHashSet();
        return !currentIds.SetEquals(originalIds);
    }

    private bool hasUnsavedProductChanges => HasUnsavedProductChanges();

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (hasUnsavedProductChanges)
        {
            var isConfirmed = await JS.InvokeAsync<bool>("confirm", "Attention : Vous avez des modifications non enregistrées pour les produits de ce marchand. Voulez-vous vraiment quitter la page sans sauvegarder ?");
            if (!isConfirmed)
            {
                context.PreventNavigation();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (!string.IsNullOrEmpty(id) && int.TryParse(id, out var parsedId) && parsedId != 0)
            {
                merchantId = parsedId;
                selectedMerchant = await Http.GetFromJsonAsync<Merchant>($"api/Merchants/{merchantId}") ?? new();

                merchantProducts = await Http.GetFromJsonAsync<List<MerchantProduct>>($"api/MerchantProducts/{merchantId}") ?? new();
                oriMerchantProducts = merchantProducts.Select(mp => new MerchantProduct
                {
                    ProductId = mp.ProductId,
                    MerchantId = mp.MerchantId,
                    Price = mp.Price,
                    Stock = mp.Stock
                }).ToList();
            }
            else
            {
                merchantId = 0;
                selectedMerchant = new Merchant { IsActive = true };
                merchantProducts = new();
                oriMerchantProducts = new();
            }

            List<Category> allCategories = await Http.GetFromJsonAsync<List<Category>>("api/Categories") ?? new();
            allActiveCategories = allCategories.Where(c => c.IsActive).ToList();
            allMerchantProducts = await Http.GetFromJsonAsync<List<MerchantProduct>>("api/MerchantProducts") ?? new();
            List<Product> allProduct = await Http.GetFromJsonAsync<List<Product>>("api/Products") ?? new();
            allActiveProduct = allProduct.Where(p => p.IsActive).ToList();

            if (allActiveCategories.Count > 0 && !allActiveCategories.Any(c => c.Id == selectedCategoryId))
            {
                selectedCategoryId = allActiveCategories[0].Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Impossible de charger les données : {ex.Message}";
            if (messageDialog is not null)
            {
                await messageDialog.ShowAsync("Erreur de chargement", errorMessage);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveMerchantChanges()
    {
        errorMessage = null;
        successMessage = null;

        // Validation côté client
        if (string.IsNullOrWhiteSpace(selectedMerchant.Adresse))
        {
            errorMessage = "L'adresse du marchand est obligatoire.";
            if (messageDialog is not null)
            {
                await messageDialog.ShowAsync("Validation", errorMessage);
            }
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedMerchant.Phone))
        {
            errorMessage = "Le numéro de téléphone du marchand est obligatoire.";
            if (messageDialog is not null)
            {
                await messageDialog.ShowAsync("Validation", errorMessage);
            }
            return;
        }

        try
        {
            if (string.IsNullOrEmpty(id) || merchantId == 0)
            {
                // Préparer un objet propre sans ID explicite pour l'insertion
                var merchantToCreate = new Merchant
                {
                    Id = 0,
                    Adresse = selectedMerchant.Adresse.Trim(),
                    Phone = selectedMerchant.Phone.Trim(),
                    IsActive = selectedMerchant.IsActive
                };

                HttpResponseMessage response = await Http.PostAsJsonAsync("api/Merchants", merchantToCreate);

                if (response.IsSuccessStatusCode)
                {
                    selectedMerchant = await response.Content.ReadFromJsonAsync<Merchant>() ?? new();
                    merchantId = selectedMerchant.Id;
                    id = selectedMerchant.Id.ToString();
                    MerchantState.SelectedMerchant = selectedMerchant;
                    successMessage = "Un nouveau commerçant a été créé avec succès !";
                    if (messageDialog is not null)
                    {
                        await messageDialog.ShowAsync("Création réussie", successMessage);
                    }
                    Navigation.NavigateTo($"/marchant-category/{merchantId}");
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Erreur lors de la création d'un nouveau commerçant : {msg}";
                    if (messageDialog is not null)
                    {
                        await messageDialog.ShowAsync("Erreur de création", errorMessage);
                    }
                }
            }
            else
            {
                var merchantToUpdate = new Merchant
                {
                    Id = selectedMerchant.Id,
                    Adresse = selectedMerchant.Adresse.Trim(),
                    Phone = selectedMerchant.Phone.Trim(),
                    IsActive = selectedMerchant.IsActive
                };

                HttpResponseMessage response = await Http.PutAsJsonAsync($"api/Merchants/{selectedMerchant.Id}", merchantToUpdate);
                if (response.IsSuccessStatusCode)
                {
                    MerchantState.SelectedMerchant = selectedMerchant;
                    successMessage = "Le commerçant a été mis à jour avec succès !";
                    if (messageDialog is not null)
                    {
                        await messageDialog.ShowAsync("Sauvegarde réussie", successMessage);
                    }
                }
                else
                {
                    var msg = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Erreur lors de la modification du commerçant : {msg}";
                    if (messageDialog is not null)
                    {
                        await messageDialog.ShowAsync("Erreur de modification", errorMessage);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite lors de la sauvegarde : {ex.Message}";
            if (messageDialog is not null)
            {
                await messageDialog.ShowAsync("Erreur de connexion", errorMessage);
            }
        }
    }

    private async Task SaveProductChanges()
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            foreach (MerchantProduct mer in merchantProducts)
            {
                if (!oriMerchantProducts.Any(d => d.MerchantId == mer.MerchantId && d.ProductId == mer.ProductId))
                {
                    int catId = allActiveProduct.FirstOrDefault(p => p.Id == mer.ProductId)?.CategoryId ?? 0;

                    if (catId > 0)
                    {
                        HttpResponseMessage response = await Http.PostAsJsonAsync($"api/MerchantCategory/{mer.MerchantId}", catId);
                        if (!response.IsSuccessStatusCode)
                        {
                            var msg = await response.Content.ReadAsStringAsync();
                            errorMessage = $"Erreur lors de l'ajout de la catégorie pour le commerçant : {msg}";
                        }
                    }

                    HttpResponseMessage response2 = await Http.PostAsJsonAsync("api/MerchantProducts", mer);
                    if (!response2.IsSuccessStatusCode)
                    {
                        var msg = await response2.Content.ReadAsStringAsync();
                        errorMessage = $"Erreur lors de l'ajout du produit pour le commerçant : {msg}";
                    }
                }    
            }

            selectedMerchant = await Http.GetFromJsonAsync<Merchant>($"api/Merchants/{merchantId}") ?? selectedMerchant;
            MerchantState.SelectedMerchant = selectedMerchant;

            oriMerchantProducts = merchantProducts.Select(mp => new MerchantProduct
            {
                ProductId = mp.ProductId,
                MerchantId = mp.MerchantId,
                Price = mp.Price,
                Stock = mp.Stock
            }).ToList();

            if (string.IsNullOrEmpty(errorMessage))
            {
                successMessage = "Les produits ont été sauvegardés avec succès !";
                if (messageDialog is not null)
                {
                    await messageDialog.ShowAsync("Sauvegarde réussie", successMessage);
                }
            }
            else
            {
                if (messageDialog is not null)
                {
                    await messageDialog.ShowAsync("Erreur lors de la sauvegarde", errorMessage);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
            if (messageDialog is not null)
            {
                await messageDialog.ShowAsync("Erreur", errorMessage);
            }
        }
    }

    private void ProductSelectionChanged(int productId, ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value!;

        if (isChecked)
        {
            Product? p = allActiveProduct.FirstOrDefault(d => d.Id == productId);
            decimal defaultPrice = p?.PriceDefault ?? 0m;
            merchantProducts.Add(new MerchantProduct { ProductId = productId, MerchantId = selectedMerchant.Id, Price = defaultPrice, Stock = 0 });
        }
        else
        {
            var item = merchantProducts.FirstOrDefault(mp => mp.ProductId == productId && mp.MerchantId == selectedMerchant.Id);
            if (item != null)
            {
                merchantProducts.Remove(item);
            }
        }
    }

    private Category GetCategoryInfo()
    {
        return allActiveCategories.FirstOrDefault(c => c.Id == selectedCategoryId) ?? new Category();
    }

    private bool IsProductInMerchant(int productId)
    {
        return merchantProducts.Any(mp => mp.ProductId == productId && mp.MerchantId == selectedMerchant.Id);
    }   

    private async Task ShowProductInfo()
    {
        if (productInfoDialog is not null)
            await productInfoDialog.ShowAsync();
    }

    private void EditProduct()
    {
        if (selectedMerchant?.Id > 0)
        {
            Navigation.NavigateTo($"/edit-product?from=marchant-category&merchantId={selectedMerchant.Id}");
        }
        else
        {
            Navigation.NavigateTo("/edit-product?from=marchant-category");
        }
    }

    private async Task DeleteMerchant()
    {
        errorMessage = null;
        successMessage = null;

        var isConfirmed = await JS.InvokeAsync<bool>("confirm",
            $"Êtes-vous sûr de vouloir supprimer le magasin #{selectedMerchant.Id} ({selectedMerchant.Adresse}) ?\n\nSi ce marchand possède des ventes enregistrées, il sera désactivé pour préserver l'historique.");

        if (!isConfirmed)
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/Merchants/{selectedMerchant.Id}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Blueberry.EntityModels.SqlServer.DTOs.DeleteProductResponse>();
                var msg = result?.Message ?? "L'opération a été effectuée avec succès.";

                if (messageDialog is not null)
                {
                    await messageDialog.ShowAsync("Suppression du marchand", msg);
                }

                Navigation.NavigateTo("/");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Erreur lors de la suppression du marchand : {errorText}";
                if (messageDialog is not null)
                {
                    await messageDialog.ShowAsync("Erreur de suppression", errorMessage);
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Une erreur s'est produite : {ex.Message}";
            if (messageDialog is not null)
            {
                await messageDialog.ShowAsync("Erreur", errorMessage);
            }
        }
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }
}
